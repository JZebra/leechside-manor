{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true
  },
  "include": ["*.ts", "../src/net/**/*.ts", "../src/model/**/*.ts", "../src/config.ts", "../src/data/**/*.ts"],
  "exclude": ["../src/net/client.ts"]
}
